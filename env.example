# Copy this file to `.env` and replace the placeholders.
# Never commit `.env` or put a live client secret in this example file.

OAUTH_CLIENT_ID=YOUR_CLIENT_ID
OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET
OAUTH_REDIRECT_URI=http://localhost:4002/oauth/callback

# Optional: production defaults to https://api.lunchmoney.dev.
# Use the beta or alpha API base URL only when Lunch Money support supplies it.
# LUNCH_MONEY_API_BASE_URL=YOUR_SUPPORT_SUPPLIED_API_BASE_URL

# Optional. Defaults to 4002.
# PORT=4002

# Optional for this local sample. Production must set a strong, stable value.
# SESSION_SECRET=
